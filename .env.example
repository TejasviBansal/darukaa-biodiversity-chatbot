# Directory where Chroma vector data will be stored in later phases.
CHROMA_PERSIST_DIR=./chroma_store

# Chroma collection name for biodiversity knowledge chunks.
CHROMA_COLLECTION_NAME=biodiversity_knowledge

# Root directory containing curated corpus text files.
CORPUS_ROOT_DIR=./corpus

# Sentence-transformer model name used for embeddings in later phases.
EMBEDDING_MODEL_NAME=all-mpnet-base-v2

# Gemini API key from Google AI Studio. Never commit a real key.
GEMINI_API_KEY=

# LLM model name used for generation.
LLM_MODEL_NAME=gemini-3.1-flash-lite

# LLM sampling temperature; lower values are more deterministic.
LLM_TEMPERATURE=0.2

# Number of retrieved chunks to consider before final filtering.
RETRIEVAL_TOP_K=8

# Minimum similarity score for retrieved chunks to remain eligible.
RETRIEVAL_SIMILARITY_CUTOFF=0.42

# Maximum number of context chunks passed into final answer generation.
MAX_FINAL_CHUNKS=5

# Maximum number of recent messages retained per in-memory session.
SESSION_HISTORY_MAX_TURNS=10

# Python logging level for the application.
LOG_LEVEL=INFO
